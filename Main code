		StopFollowing()
	else
		State.FollowPlayer = true
		FollowToggle.Text = "Follow: ON"
		FollowToggle.BackgroundColor3 = CONFIG.Colors.Success
		FollowToggle.TextColor3 = CONFIG.Colors.TextPrimary

		FollowConnection = RunService.Heartbeat:Connect(function()
			if not State.FollowPlayer or not State.SelectedPlayer then return end

			local myChar = LocalPlayer.Character
			local targetChar = State.SelectedPlayer.Character
			if not myChar or not targetChar then return end

			local myRoot = myChar:FindFirstChild("HumanoidRootPart")
			local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
			if not myRoot or not targetRoot then return end

			local distance = (myRoot.Position - targetRoot.Position).Magnitude
			if distance > 10 then
				local direction = (targetRoot.Position - myRoot.Position).Unit
				local targetPos = targetRoot.Position - direction * 5
				myRoot.CFrame = CFrame.new(targetPos, targetRoot.Position)
			end
		end)

		PlaySound(CONFIG.Sounds.Success, 0.2)
	end
end)

-- SERVER HOPPER
local function ServerHop(preferredSize)
	local placeId = game.PlaceId
	local jobId = game.JobId

	ServerStatus.Text = "Fetching servers..."
	ServerStatus.TextColor3 = CONFIG.Colors.Warning

	local success, result = pcall(function()
		local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", placeId)
		local response = game:HttpGet(url)
		local data = HttpService:JSONDecode(response)
		return data
	end)

	if not success or not result or not result.data then
		ServerStatus.Text = "Failed to fetch servers"
		ServerStatus.TextColor3 = CONFIG.Colors.Danger
		Notify("Server Hop Failed", "Could not fetch server list")
		return
	end

	local servers = result.data
	local targetServer = nil

	if preferredSize == "small" then
		-- Find smallest server with players
		local smallestSize = math.huge
		for _, server in pairs(servers) do
			if server.id ~= jobId and server.playing > 0 and server.playing < smallestSize then
				smallestSize = server.playing
				targetServer = server
			end
		end
	elseif preferredSize == "random" then
		-- Pick random server
		local validServers = {}
		for _, server in pairs(servers) do
			if server.id ~= jobId and server.playing > 0 then
				table.insert(validServers, server)
			end
		end
		if #validServers > 0 then
			targetServer = validServers[math.random(1, #validServers)]
		end
	end

	if targetServer then
		ServerStatus.Text = "Teleporting..."
		ServerStatus.TextColor3 = CONFIG.Colors.Success
		PlaySound(CONFIG.Sounds.Success, 0.3)
		Notify("Server Hopping", string.format("Joining server with %d players...", targetServer.playing))
		TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, LocalPlayer)
	else
		ServerStatus.Text = "No servers found"
		ServerStatus.TextColor3 = CONFIG.Colors.Danger
		Notify("Server Hop Failed", "No suitable servers found")
	end
end

