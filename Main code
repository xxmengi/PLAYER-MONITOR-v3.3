			distanceLabel.Text = "-- studs"
		end
		if humanoid and humanoid.MaxHealth > 0 then
			local pct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
			healthLabel.Text = string.format("%d%%", math.floor(pct * 100 + 0.5))
			healthFill.Size = UDim2.new(pct, 0, 1, 0)
			if pct > 0.6 then healthFill.BackgroundColor3 = CONFIG.Colors.Success
			elseif pct > 0.3 then healthFill.BackgroundColor3 = CONFIG.Colors.Warning
			else healthFill.BackgroundColor3 = CONFIG.Colors.Danger end
		end
		return true
	end
	update()
end

