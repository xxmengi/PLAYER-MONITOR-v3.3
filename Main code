-- ACTION LOGIC
UpdateActionPanel = function(player)
	if not player then return end

	-- Profile
	AvatarImage.Image = GetPlayerThumbnail(player.UserId)
	ProfileName.Text = player.DisplayName
	ProfileUser.Text = "@" .. player.Name
	ProfileId.Text = "ID: " .. player.UserId

	-- Update status
	local function UpdateStatus()
		if player == LocalPlayer then
			ProfileStatus.Text = "Status: You"
			ProfileStatus.TextColor3 = CONFIG.Colors.Accent
		else
			local char = player.Character
			if char and char:FindFirstChild("Humanoid") then
				local humanoid = char.Humanoid
				if humanoid.Health > 0 then
					ProfileStatus.Text = "Status: Alive"
					ProfileStatus.TextColor3 = CONFIG.Colors.Success
				else
					ProfileStatus.Text = "Status: Dead"
					ProfileStatus.TextColor3 = CONFIG.Colors.Danger
				end
			else
				ProfileStatus.Text = "Status: Loading..."
				ProfileStatus.TextColor3 = CONFIG.Colors.TextMuted
			end
		end
	end

	-- Stats
	local function UpdateStats()
		if not State.SelectedPlayer or State.SelectedPlayer ~= player then return end

		local char = player.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")

		if humanoid then
			StatHealth.Value.Text = string.format("%.0f/%.0f HP", humanoid.Health, humanoid.MaxHealth)
		else
			StatHealth.Value.Text = "N/A"
		end

		if char and char:FindFirstChild("HumanoidRootPart") then
			local pos = char.HumanoidRootPart.Position
			StatPosition.Value.Text = string.format("X:%.0f Y:%.0f Z:%.0f", pos.X, pos.Y, pos.Z)

			local myChar = LocalPlayer.Character
			if myChar and myChar:FindFirstChild("HumanoidRootPart") then
				local dist = (pos - myChar.HumanoidRootPart.Position).Magnitude
				StatDistance.Value.Text = string.format("%.1f studs", dist)
			else
				StatDistance.Value.Text = "N/A"
			end
		else
			StatPosition.Value.Text = "N/A"
			StatDistance.Value.Text = "N/A"
		end

		StatTeam.Value.Text = player.Team and player.Team.Name or "Neutral"
		StatTeam.Value.TextColor3 = player.Team and player.Team.TeamColor.Color or CONFIG.Colors.TextMuted

		UpdateStatus()
	end

	-- Clean old connections
	for _, conn in pairs(State.Connections) do
		conn:Disconnect()
	end
	State.Connections = {}

	-- Update stats loop
	table.insert(State.Connections, RunService.Heartbeat:Connect(UpdateStats))

	-- Update on character changes
	table.insert(State.Connections, player.CharacterAdded:Connect(UpdateStats))

	UpdateStats()

	-- Inventory Inspector Logic
	local function UpdateInventory()
		if not State.SelectedPlayer or State.SelectedPlayer ~= player then return end
		for _, child in pairs(InventoryList:GetChildren()) do
			if child:IsA("Frame") then child:Destroy() end
		end
		local char = player.Character
		local backpack = player:FindFirstChild("Backpack")
		local hasItems = false
		local toolNames = {}
		if char then
			for _, tool in pairs(char:GetChildren()) do
				if tool:IsA("Tool") then
					toolNames[tool.Name] = true
					CreateToolCard(tool.Name, true).Parent = InventoryList
					hasItems = true
				end
			end
		end
		if backpack then
			for _, tool in pairs(backpack:GetChildren()) do
				if tool:IsA("Tool") and not toolNames[tool.Name] then
					CreateToolCard(tool.Name, false).Parent = InventoryList
					hasItems = true
				end
			end
		end
		InventoryEmpty.Visible = not hasItems
	end

	-- Session Tracker Logic
	local function UpdateSession()
		if not State.SelectedPlayer or State.SelectedPlayer ~= player then return end
		local joinTime = PlayerJoinTimes[player]
		if joinTime then
			local joinedDate = os.date("%H:%M:%S", joinTime)
			SessionJoined.Text = "Joined At: " .. joinedDate
			local elapsed = os.time() - joinTime
			local hrs = math.floor(elapsed / 3600)
			local mins = math.floor((elapsed % 3600) / 60)
			local secs = elapsed % 60
			SessionDuration.Text = string.format("Session Time: %02d:%02d:%02d", hrs, mins, secs)
		else
			SessionJoined.Text = "Joined At: --:--:--"
			SessionDuration.Text = "Session Time: 00:00:00"
		end
		local serverElapsed = os.time() - ServerStartTime
		local sHrs = math.floor(serverElapsed / 3600)
		local sMins = math.floor((serverElapsed % 3600) / 60)
		local sSecs = serverElapsed % 60
		SessionServer.Text = string.format("Server Uptime: %02d:%02d:%02d", sHrs, sMins, sSecs)
	end

	-- Animation Monitor Logic
	local function UpdateAnimation()
		if not State.SelectedPlayer or State.SelectedPlayer ~= player then return end
		local char = player.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			AnimSpeed.Value.Text = tostring(math.floor(humanoid.WalkSpeed + 0.5)) .. " studs/s"
			AnimJump.Value.Text = tostring(math.floor(humanoid.JumpPower + 0.5)) .. " power"
			AnimState.Value.Text = (tostring(humanoid:GetState()):gsub("Enum.HumanoidStateType.", ""))
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if animator then
				local playing = animator:GetPlayingAnimationTracks()
				if #playing > 0 then
					local current = playing[1]
					local animName = current.Name
					if animName == "" then animName = "Unnamed Track" end
					AnimCurrent.Value.Text = animName
				else
					AnimCurrent.Value.Text = "Idle / None"
				end
			else
				AnimCurrent.Value.Text = "No Animator"
			end
		else
			AnimSpeed.Value.Text = "N/A"
			AnimJump.Value.Text = "N/A"
			AnimState.Value.Text = "N/A"
			AnimCurrent.Value.Text = "N/A"
		end
	end

