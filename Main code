ESPUpdateConnection = RunService.RenderStepped:Connect(function()
	if not State.ESP then return end

	local myCharacter = LocalPlayer.Character
	local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

	for player, billboard in pairs(State.ESPObjects) do
		if not player:IsDescendantOf(Players) or not billboard or not billboard.Parent then
			State.ESPObjects[player] = nil
		else
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local head = char and char:FindFirstChild("Head")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local card = billboard:FindFirstChild("Card")

			if card then
				-- Never let a missing optional UI child stop the whole render loop.
				local color = GetPlayerVisualColor(player)
				local glowStroke = card:FindFirstChild("GlowStroke")
				if glowStroke then glowStroke.Color = color end

				local accentBar = card:FindFirstChild("Accent")
				if accentBar then accentBar.BackgroundColor3 = color end

				local displayName = card:FindFirstChild("DisplayName")
				if displayName then
					displayName.TextColor3 = color
					displayName.Text = player.DisplayName
				end

				local username = card:FindFirstChild("Username")
				if username then username.Text = "@" .. player.Name end

				if root or head then billboard.Adornee = head or root end

				local distanceLabel = card:FindFirstChild("Distance")
				if myRoot and root then
					local distance = (root.Position - myRoot.Position).Magnitude
					local automaticOffset = math.clamp(4.2 + (distance / 120), 4.2, 12)
					billboard.StudsOffset = Vector3.new(0, automaticOffset, 0)
					if distanceLabel then
						distanceLabel.Text = string.format("%.0f studs away", distance)
					end
				else
					billboard.StudsOffset = Vector3.new(0, 4.2, 0)
					if distanceLabel then distanceLabel.Text = "-- studs away" end
				end

				local healthText = card:FindFirstChild("HealthText")
				local healthFill = card:FindFirstChild("HealthFill", true)
				if hum and hum.MaxHealth > 0 then
					local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
					if healthText then healthText.Text = string.format("%d%%", math.floor(pct * 100 + 0.5)) end
					if healthFill then
						healthFill.Size = UDim2.new(pct, 0, 1, 0)
						healthFill.BackgroundColor3 = pct > .6 and CONFIG.Colors.Success or (pct > .3 and CONFIG.Colors.Warning or CONFIG.Colors.Danger)
					end
				end
			end
		end
	end
end)

GlowPulseConnection = RunService.RenderStepped:Connect(function()
	if not State.Highlight then return end
	local t = os.clock()
	for player, highlight in pairs(State.HighlightObjects) do
		if not player:IsDescendantOf(Players) or not highlight then State.HighlightObjects[player] = nil
		else
			local color = GetPlayerVisualColor(player)
			highlight.FillColor = color
			highlight.OutlineColor = color:Lerp(Color3.new(1, 1, 1), 0.45)
			local pulse = (math.sin(t * 3) + 1) * 0.5
			highlight.FillTransparency = 0.78 - pulse * 0.12
			highlight.OutlineTransparency = 0.18 - pulse * 0.14
			if player.Character and highlight.Parent ~= player.Character then highlight.Parent = player.Character end
		end
	end
end)

