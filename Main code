local function ClearESP()
	for player, obj in pairs(State.ESPObjects) do
		if obj then pcall(function() obj:Destroy() end) end
		State.ESPObjects[player] = nil
	end
	-- Failsafe: remove any ESP billboards not tracked in the current table.
	for _, obj in ipairs(CoreGui:GetChildren()) do
		if obj.Name == "PM_PremiumESP" then
			pcall(function() obj:Destroy() end)
		end
	end
end

local function ClearHighlights()
	for player, obj in pairs(State.HighlightObjects) do
		if obj then pcall(function() obj:Destroy() end) end
		State.HighlightObjects[player] = nil
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char then
			for _, obj in ipairs(char:GetChildren()) do
				if obj.Name == "PM_PremiumGlow" then
					pcall(function() obj:Destroy() end)
				end
			end
		end
	end
end

local function GetPlayerVisualColor(player)
	if player.Team and player.Team.TeamColor then
