State.AutoRefreshRunning = false

function State:StartAutoRefresh()
	if self.AutoRefreshRunning then return end
	self.AutoRefreshRunning = true
	task.spawn(function()
		while self.AutoRefresh and MainFrame and MainFrame.Parent do
			UpdatePlayerList()
			task.wait(3)
		end
		self.AutoRefreshRunning = false
	end)
end

function State:StopAutoRefresh()
	self.AutoRefresh = false
end

