local function TeleportToPlayer(mode)
	if not State.SelectedPlayer then return end

	local targetPlayer = State.SelectedPlayer
	local myChar = LocalPlayer.Character
	local targetChar = targetPlayer.Character

	if not myChar then
		Notify("Teleport Failed", "Your character doesn't exist!")
		return
	end

	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then
		Notify("Teleport Failed", "HumanoidRootPart not found!")
		return
	end

	local function GetTargetPosition()
		local char = targetPlayer.Character
		if not char then return nil end

		local root = char:FindFirstChild("HumanoidRootPart")
		if root then return root end

		local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
		if torso then return torso end

		return char:FindFirstChild("Humanoid") and char.Humanoid.RootPart
	end

	local targetPart = GetTargetPosition()
	if not targetPart then
		Notify("Teleport Failed", "Target character not found!")
		return
	end

	local targetCFrame
	local offset = Vector3.new(0, 0, 0)

	if mode == "ToPlayer" then
		offset = Vector3.new(0, 3, 0)
		targetCFrame = targetPart.CFrame + offset
	elseif mode == "Behind" then
		offset = -targetPart.CFrame.LookVector * 5 + Vector3.new(0, 0, 0)
		targetCFrame = CFrame.new(targetPart.Position + offset, targetPart.Position)
	elseif mode == "Front" then
		offset = targetPart.CFrame.LookVector * 5 + Vector3.new(0, 0, 0)
		targetCFrame = CFrame.new(targetPart.Position + offset, targetPart.Position + targetPart.CFrame.LookVector * 10)
	elseif mode == "Above" then
		offset = Vector3.new(0, 8, 0)
		targetCFrame = targetPart.CFrame + offset
	elseif mode == "Below" then
		offset = Vector3.new(0, -5, 0)
		targetCFrame = targetPart.CFrame + offset
	elseif mode == "Smart" then
		local basePos = targetPart.Position
		local bestPos = basePos + Vector3.new(0, 5, 5)
		local bestDist = math.huge

		for x = -10, 10, 5 do
			for z = -10, 10, 5 do
				local testPos = basePos + Vector3.new(x, 5, z)
				local rayOrigin = testPos + Vector3.new(0, 50, 0)
				local rayDirection = Vector3.new(0, -100, 0)
				local raycastParams = RaycastParams.new()
				raycastParams.FilterDescendantsInstances = {myChar, targetChar}
				raycastParams.FilterType = Enum.RaycastFilterType.Exclude

				local result = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
				if result then
					local groundPos = result.Position + Vector3.new(0, 3, 0)
					local dist = (groundPos - basePos).Magnitude
					if dist < bestDist and dist > 3 then
						bestDist = dist
						bestPos = groundPos
					end
				end
			end
		end
		targetCFrame = CFrame.new(bestPos, basePos)
	end

	if State.TeleportTween then
		local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = TweenService:Create(myRoot, tweenInfo, {CFrame = targetCFrame})
		tween:Play()
		PlaySound(CONFIG.Sounds.Success, 0.2)
	else
		myRoot.CFrame = targetCFrame
		PlaySound(CONFIG.Sounds.Click, 0.2)
	end

	Notify("Teleported", string.format("%s to %s", mode, targetPlayer.DisplayName))
end

