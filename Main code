-- SPY SYSTEM
local SpyConnections = {}
local CurrentOrbitAngle = 0

StopSpying = function()
	if not State.IsSpying then return end
	State.IsSpying = false

	-- Restore camera
	local camera = Workspace.CurrentCamera
	camera.CameraType = State.OriginalCamera.Type
	camera.CameraSubject = State.OriginalCamera.Subject
	camera.FieldOfView = State.OriginalCamera.FieldOfView
	if State.OriginalCamera.CFrame then
		local camTween = TweenService:Create(camera, CONFIG.Animations.Smooth, { CFrame = State.OriginalCamera.CFrame })
		if camTween then camTween:Play() end
	end

	-- Cleanup
	for _, conn in pairs(SpyConnections) do
		conn:Disconnect()
	end
	SpyConnections = {}

	SpyToggle.Text = "Start Spying"
	SpyToggle.BackgroundColor3 = CONFIG.Colors.Success
	SpyHud.Visible = false

	PlaySound(CONFIG.Sounds.Click, 0.2)
end

local function StartSpying()
	if State.IsSpying or not State.SelectedPlayer then return end

	local player = State.SelectedPlayer
	local camera = Workspace.CurrentCamera

	-- Save original camera state
	State.OriginalCamera.Type = camera.CameraType
	State.OriginalCamera.Subject = camera.CameraSubject
	State.OriginalCamera.CFrame = camera.CFrame
	State.OriginalCamera.FieldOfView = camera.FieldOfView

	State.IsSpying = true
	SpyToggle.Text = "Stop Spying"
	SpyToggle.BackgroundColor3 = CONFIG.Colors.Danger

	HudTarget.Text = "Target: " .. player.DisplayName
	HudMode.Text = "Mode: " .. (State.SpyMode:gsub("(%l)(%u)", "%1 %2"))
	HudFov.Text = "FOV: " .. tostring(State.SpyFov)
	SpyHud.Visible = State.SpyOverlayEnabled

	PlaySound(CONFIG.Sounds.Success, 0.3)

	local function GetTargetSubject()
		local char = player.Character
		if char then
			return char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("HumanoidRootPart")
		end
		return nil
	end

	-- Apply FOV
	camera.FieldOfView = State.SpyFov

	if State.SpyMode == "Follow" then
		-- This properly follows the target without snapping back to local player
		camera.CameraType = Enum.CameraType.Custom
		local subject = GetTargetSubject()
		if subject then
			camera.CameraSubject = subject
		end

		-- Auto-reconnect on respawn
		table.insert(SpyConnections, player.CharacterAdded:Connect(function(char)
			if State.IsSpying and State.SpyMode == "Follow" then
				task.wait(0.5)
				local humanoid = char:WaitForChild("Humanoid", 3)
				if humanoid then
					camera.CameraSubject = humanoid
				end
			end
		end))

		-- Keep updating camera subject in case it gets reset
		table.insert(SpyConnections, RunService.Heartbeat:Connect(function()
			if not State.IsSpying or State.SpyMode ~= "Follow" then return end
			if camera.CameraSubject ~= GetTargetSubject() then
				local subject = GetTargetSubject()
				if subject then
					camera.CameraSubject = subject
				end
			end
		end))

	elseif State.SpyMode == "Orbit" then
		camera.CameraType = Enum.CameraType.Scriptable
		CurrentOrbitAngle = 0

		table.insert(SpyConnections, RunService.RenderStepped:Connect(function(dt)
			if not State.IsSpying or State.SpyMode ~= "Orbit" then return end

			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			CurrentOrbitAngle += dt * 0.5
			local offset = Vector3.new(
				math.sin(CurrentOrbitAngle) * State.SpyOrbitDistance,
				math.sin(CurrentOrbitAngle * 0.5) * 5 + 8,
				math.cos(CurrentOrbitAngle) * State.SpyOrbitDistance
			)

			local targetPos = root.Position + offset
			camera.CFrame = CFrame.new(targetPos, root.Position)
		end))

	elseif State.SpyMode == "FirstPerson" then
		camera.CameraType = Enum.CameraType.Scriptable

		table.insert(SpyConnections, RunService.RenderStepped:Connect(function()
			if not State.IsSpying or State.SpyMode ~= "FirstPerson" then return end

			local char = player.Character
			local head = char and char:FindFirstChild("Head")
			if not head then return end

			camera.CFrame = head.CFrame
		end))

	elseif State.SpyMode == "Freecam" then
		camera.CameraType = Enum.CameraType.Scriptable

		local targetCFrame = camera.CFrame
		table.insert(SpyConnections, RunService.RenderStepped:Connect(function()
			if not State.IsSpying or State.SpyMode ~= "Freecam" then return end

			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			local desiredPos = root.Position + Vector3.new(0, 15, State.SpyOrbitDistance)
			targetCFrame = targetCFrame:Lerp(CFrame.new(desiredPos, root.Position), 0.05)
			camera.CFrame = targetCFrame
		end))
	end
end

