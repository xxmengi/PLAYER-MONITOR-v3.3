	nameLabel.Parent = card

	local userLabel = Instance.new("TextLabel")
	userLabel.Name = "Username"
	userLabel.Size = UDim2.new(1, -24, 0, 16)
	userLabel.Position = UDim2.new(0, 17, 0, 27)
	userLabel.BackgroundTransparency = 1
	userLabel.Font = Enum.Font.Gotham
	userLabel.TextSize = 10
	userLabel.TextColor3 = CONFIG.Colors.TextSecondary
	userLabel.TextXAlignment = Enum.TextXAlignment.Left
	userLabel.Parent = card

	local distanceLabel = Instance.new("TextLabel")
	distanceLabel.Name = "Distance"
	distanceLabel.Size = UDim2.new(0.48, 0, 0, 16)
	distanceLabel.Position = UDim2.new(0, 17, 0, 46)
	distanceLabel.BackgroundTransparency = 1
	distanceLabel.Font = Enum.Font.GothamBold
	distanceLabel.TextSize = 10
	distanceLabel.TextColor3 = CONFIG.Colors.TextPrimary
	distanceLabel.TextXAlignment = Enum.TextXAlignment.Left
	distanceLabel.Parent = card

	local healthLabel = Instance.new("TextLabel")
	healthLabel.Name = "HealthText"
	healthLabel.Size = UDim2.new(0.42, 0, 0, 16)
	healthLabel.Position = UDim2.new(0.58, -10, 0, 46)
	healthLabel.BackgroundTransparency = 1
	healthLabel.Font = Enum.Font.GothamBold
	healthLabel.TextSize = 10
	healthLabel.TextColor3 = CONFIG.Colors.Success
	healthLabel.TextXAlignment = Enum.TextXAlignment.Right
	healthLabel.Parent = card

	local healthBack = Instance.new("Frame")
	healthBack.Size = UDim2.new(1, -24, 0, 4)
	healthBack.Position = UDim2.new(0, 17, 1, -10)
	healthBack.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
	healthBack.BorderSizePixel = 0
	healthBack.Parent = card
	CreateCorner(healthBack, 2)

	local healthFill = Instance.new("Frame")
	healthFill.Name = "HealthFill"
	healthFill.Size = UDim2.new(1, 0, 1, 0)
	healthFill.BackgroundColor3 = CONFIG.Colors.Success
	healthFill.BorderSizePixel = 0
	healthFill.Parent = healthBack
	CreateCorner(healthFill, 2)

	billboard.Parent = CoreGui
	State.ESPObjects[player] = billboard

	local function update()
		if not billboard.Parent then return false end
		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local head = char and char:FindFirstChild("Head")
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		local color = GetPlayerVisualColor(player)
		stroke.Color = color
		accent.BackgroundColor3 = color
		nameLabel.TextColor3 = color
		nameLabel.Text = player.DisplayName
		userLabel.Text = "@" .. player.Name
		if root or head then billboard.Adornee = head or root end
		if myRoot and root then
			local distance = (root.Position - myRoot.Position).Magnitude
			-- Automatically raise the ESP farther above the character as distance changes.
			local automaticOffset = math.clamp(4.2 + (distance / 120), 4.2, 12)
			billboard.StudsOffset = Vector3.new(0, automaticOffset, 0)
			distanceLabel.Text = string.format("%.0f studs", distance)
