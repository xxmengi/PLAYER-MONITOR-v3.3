-- Remove ESP/glow objects left behind (so it wont be buggy)
local function RemoveOrphanedVisuals()
	for _, obj in ipairs(CoreGui:GetChildren()) do
		if obj.Name == "PM_PremiumESP" or obj.Name == "PM_PremiumGlow" then
			pcall(function() obj:Destroy() end)
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char then
			for _, obj in ipairs(char:GetChildren()) do
				if obj.Name == "PM_PremiumGlow" then
					pcall(function() obj:Destroy() end)
				end
			end
		end
	end
end
RemoveOrphanedVisuals()

